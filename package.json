{
  "name": "mma-calendar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "description": "Automatically updated MMA calendar feeds for UFC, ONE Championship, RIZIN and PFL.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "generate": "tsc && node dist/src/index.js",
    "preview": "tsc && node dist/src/tools/preview.js",
    "test": "tsc && node --test dist/test/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cheerio": "1.1.2"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "domhandler": "5.0.3",
    "typescript": "5.9.3"
  }
}
